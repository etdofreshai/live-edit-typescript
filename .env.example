GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# Comma-separated list of GitHub owners/orgs to list repos from.
# The first entry is the default owner. Defaults to "etdofreshai" if unset.
GITHUB_OWNERS=etdofreshai
WEBHOOK_SECRET=live-edit-webhook-secret
WEBHOOK_URL=https://liveedittypescript.etdofresh.com/api/webhook

# Voice-to-OpenClaw
OPENAI_API_KEY=sk-...
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your-token-here
