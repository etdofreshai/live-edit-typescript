# Optional: GitHub token used to list repos and register webhooks.
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Required in production: shared secret used to verify GitHub webhook signatures.
WEBHOOK_SECRET=change-me

# Required in production: full HTTPS callback URL for this server's webhook endpoint.
WEBHOOK_URL=https://liveedittypescript.example.com/api/webhook

# Optional: runtime mode; defaults to development when unset.
NODE_ENV=development

# Optional: OpenAI API key for voice transcription.
OPENAI_API_KEY=sk-...

# Optional: OpenClaw gateway URL for voice-to-agent requests.
OPENCLAW_GATEWAY_URL=http://localhost:18789

# Optional: OpenClaw gateway bearer token for voice-to-agent requests.
OPENCLAW_GATEWAY_TOKEN=your-token-here
